### 8.3 · Archive
# Template archived: new sends with it get 409; queued ones still go out.
# Path params: template id = <TEMPLATE_ID>  (id from Create template)
# Expected: 200
# @name r46_archive
POST {{baseUrl}}/v1/templates/{{r18_create_template.response.body.$.id}}/archive
x-api-key: {{r5_create_tenant.response.body.$.apiKey.key}}

### 8.4 · Unregister device
# Device token removed; the user stops getting push on it.
# Path params: token = <FCM_TOKEN>  (the device token from your app)
# Expected: 204
# @name r47_unregister_device
DELETE {{baseUrl}}/v1/devices/{{FCM_TOKEN}}
x-api-key: {{r5_create_tenant.response.body.$.apiKey.key}}
