<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="p1" name="1. Setup and send"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Setup and send: which API first, then next" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Start: service running&lt;br&gt;GET :9464/health/ready" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="260" height="50" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;1. Admin creates the tenant&lt;/b&gt;&lt;br&gt;POST /v1/admin/tenants&lt;br&gt;header x-admin-key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="300" height="70" as="geometry"/></mxCell><mxCell id="n5" value="Response: &lt;b&gt;apiKey.key&lt;/b&gt; (shown once)&lt;br&gt;use it as &lt;b&gt;x-api-key&lt;/b&gt; for every next call" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="680" y="155" width="300" height="60" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;2. Add providers&lt;/b&gt;&lt;br&gt;POST /v1/providers&lt;br&gt;channel + provider + credentials&lt;br&gt;settings.from + fromAddresses + limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="250" width="300" height="90" as="geometry"/></mxCell><mxCell id="n7" value="Check From addresses&lt;br&gt;GET /v1/from-addresses?channel=..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="370" width="300" height="60" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;3. Templates&lt;/b&gt; (optional, starters otp / welcome)&lt;br&gt;POST /v1/templates&lt;br&gt;POST /v1/templates/{id}/preview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="460" width="300" height="80" as="geometry"/></mxCell><mxCell id="n9" value="Push or in-app?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="365" y="570" width="190" height="90" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;4. Register devices&lt;/b&gt;&lt;br&gt;POST /v1/devices&lt;br&gt;userId + FCM token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="580" width="260" height="70" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;5. Send&lt;/b&gt;&lt;br&gt;POST /v1/notifications&lt;br&gt;channel + recipient / userId&lt;br&gt;template or body + from" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="310" y="700" width="300" height="90" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;202 Accepted&lt;/b&gt;&lt;br&gt;notification.id + queue state" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="680" y="715" width="260" height="60" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;6. Track&lt;/b&gt;&lt;br&gt;GET /v1/notifications/{id}&lt;br&gt;status, providerName, sentFrom, attempts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="830" width="300" height="80" as="geometry"/></mxCell><mxCell id="n14" value="Status?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="385" y="940" width="150" height="90" as="geometry"/></mxCell><mxCell id="n15" value="Done (SENT)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="960" width="150" height="50" as="geometry"/></mxCell><mxCell id="n16" value="FAILED → retry&lt;br&gt;POST /v1/notifications/{id}/retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="950" width="260" height="60" as="geometry"/></mxCell><mxCell id="n17" value="Scheduled (QUEUED) → cancel&lt;br&gt;POST /v1/notifications/{id}/cancel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="1080" width="260" height="60" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;7. In-app inbox&lt;/b&gt;&lt;br&gt;GET /v1/users/{user_id}/inbox&lt;br&gt;POST .../inbox/read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="840" width="260" height="70" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="SENT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="FAILED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n16" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="QUEUED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n14" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="in-app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n13" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. API call → business logic"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="How one API call reaches the business logic (example: ListFromAddresses)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Client&lt;br&gt;Swagger / Postman / app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e78;strokeColor=#1f4e78;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="180" height="70" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;HTTP gateway :3000&lt;/b&gt;&lt;br&gt;src/gateway/http-gateway.ts&lt;br&gt;match path + verb from proto&lt;br&gt;google.api.http" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="240" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;gRPC server :50051&lt;/b&gt;&lt;br&gt;NestJS microservice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="220" height="70" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;AuthGuard&lt;/b&gt;&lt;br&gt;x-api-key valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="180" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;ApiKeyService.resolve&lt;/b&gt;&lt;br&gt;sha256(key) → tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="920" y="265" width="220" height="70" as="geometry"/></mxCell><mxCell id="n8" value="Redis&lt;br&gt;api key cache" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1220" y="180" width="140" height="80" as="geometry"/></mxCell><mxCell id="n9" value="Postgres&lt;br&gt;api_keys + tenants" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1220" y="320" width="140" height="80" as="geometry"/></mxCell><mxCell id="n10" value="401 API_KEY_INVALID&lt;br&gt;403 TENANT_INACTIVE" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="270" width="200" height="60" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;ProviderController&lt;/b&gt;&lt;br&gt;@GrpcMethod ListFromAddresses&lt;br&gt;(req, @CurrentTenant tenant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="420" width="260" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;ProviderConfigService&lt;/b&gt;&lt;br&gt;fromAddresses(tenant.tenantId, channel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="920" y="430" width="280" height="70" as="geometry"/></mxCell><mxCell id="n13" value="200 JSON&lt;br&gt;{ fromAddresses: [...] }" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="180" height="60" as="geometry"/></mxCell><mxCell id="n14" value="No tenantId field: the tenant comes from the &lt;b&gt;x-api-key&lt;/b&gt; header. The guard resolves the key to its tenant; the controller receives it as &lt;b&gt;@CurrentTenant()&lt;/b&gt;. A gRPC client skips the gateway and calls :50051 with the same metadata." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="560" height="80" as="geometry"/></mxCell><mxCell id="e15" value="1. GET /api/v1/from-addresses&lt;br&gt;x-api-key: chk_..." style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="2. gRPC call&lt;br&gt;key as metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="4. resolve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="5. cached?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="6. on miss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n6" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="7. yes, tenant attached" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n6" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="9. list" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=0.25;exitY=1;entryX=0.75;entryY=1;" edge="1" parent="1" source="n12" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="10. proto → JSON via gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. Delivery pipeline"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Delivery: queue, provider, From, limits, failover, retry" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="n3" value="POST /v1/notifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="240" height="50" as="geometry"/></mxCell><mxCell id="n4" value="Validate request&lt;br&gt;tenant from x-api-key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="240" height="60" as="geometry"/></mxCell><mxCell id="n5" value="From known?&lt;br&gt;(name or address)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="85" y="240" width="190" height="100" as="geometry"/></mxCell><mxCell id="n6" value="404 FROM_NOT_FOUND" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="265" width="200" height="50" as="geometry"/></mxCell><mxCell id="n7" value="Save notification &lt;b&gt;QUEUED&lt;/b&gt;&lt;br&gt;recipient + data encrypted&lt;br&gt;template version pinned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="240" height="70" as="geometry"/></mxCell><mxCell id="n8" value="BullMQ job on notifications-&amp;lt;channel&amp;gt;&lt;br&gt;priority, delay, attempts + backoff&lt;br&gt;from the provider limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="