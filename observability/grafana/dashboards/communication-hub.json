          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(chub_notifications_finished_total{status=\"failed\"}[15m])) / clamp_min(sum(rate(chub_notifications_finished_total[15m])), 1e-9)",
          "refId": "A"
