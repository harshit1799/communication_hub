# Copy this file to .env and adjust values. All variables are optional.

# Runtime environment: development | production | test
NODE_ENV=development
# HTTP port the server listens on
PORT=3000
# Service display name (also used as the Swagger title)
APP_NAME=Communication Hub
# Global route prefix -> http://localhost:3000/api/...
API_PREFIX=api
# Comma-separated list, or * to allow all
CORS_ORIGINS=*
# Set to false to hide Swagger (e.g. in production)
SWAGGER_ENABLED=true
# Swagger UI path -> http://localhost:3000/docs
SWAGGER_PATH=docs

# NestJS Observe (optional) - https://observe.nestjs.com
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Email - default sender address
MAIL_FROM=Communication Hub <no-reply@example.com>
# SMTP server. Leave SMTP_HOST empty to log emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=db_name
# true for managed databases that require TLS (RDS, Neon, Supabase, ...)
DB_SSL=false
# true to log every SQL query
DB_LOGGING=false
