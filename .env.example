# Copy this file to .env and adjust values. Validated at startup
# (src/config/env.validation.ts); the app refuses to start on bad config.

# ---------- Environment & secrets ----------
# Deployment environment: local | development | staging | preprod | production
# Everything except `local` loads its variables from AWS Secrets Manager
# (secret "communication-hub/<APP_ENV>-env", a JSON object of the variables in
# this file). Secret values override .env and container variables.
APP_ENV=local
# Optional: use a differently named secret
AWS_SECRET_NAME=
# APP_ENV, APP_ROLE, AWS_REGION and AWS_SECRET_NAME must be set on the
# container (not inside the secret): they are read before it loads.

# ---------- App ----------
# Runtime mode: development (pretty logs) | production | test
NODE_ENV=development
# api = gRPC only, worker = queue workers only, all = both (local dev)
APP_ROLE=all
APP_NAME=Communication Hub
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# ---------- gRPC API ----------
GRPC_PORT=50051
# Max message size both ways (bulk sends can be large)
GRPC_MAX_MESSAGE_BYTES=8388608
# Server reflection for grpcurl/Postman (default: on locally, off elsewhere)
GRPC_REFLECTION=
# ---------- HTTP/JSON gateway + Swagger UI ----------
# REST-style access to the same gRPC API: POST /api/v1/<Service>/<Method>
# 0 disables the gateway (gRPC only).
HTTP_PORT=3000
# Max request body (bulk sends can be large)
BODY_LIMIT_BYTES=5242880
# Swagger UI at /<SWAGGER_PATH> (default: on locally, off elsewhere)
SWAGGER_ENABLED=
SWAGGER_PATH=docs
# Set both to protect the docs with HTTP basic auth
SWAGGER_USER=
SWAGGER_PASS=

# Health (/health/live, /health/ready) + Prometheus /metrics, every role.
# Cluster-internal only; 0 disables it.
OPS_PORT=9464

# ---------- Encryption (recipients, template data, provider credentials) ----------
# Required in every environment. AES-256-GCM keys as "id:base64" pairs; keep
# old keys listed after a rotation until all data is re-encrypted.
#   generate: echo "k1:$(openssl rand -base64 32)"
ENCRYPTION_KEYS=
# Key id new values are encrypted with (default: the last listed)
ENCRYPTION_ACTIVE_KEY=k1
# HMAC key for recipient lookups (blind index); never change casually.
#   generate: openssl rand -base64 32
BLIND_INDEX_KEY=

# ---------- Send-path caches (Redis), seconds ----------
# Changes made through the API invalidate immediately; TTL bounds staleness
# if an invalidation is lost (e.g. Redis was down during the change).
PROVIDER_CACHE_TTL_SECONDS=300
SENDER_CACHE_TTL_SECONDS=300
TEMPLATE_CACHE_TTL_SECONDS=300

# ---------- Auth ----------
# Secret for the *AdminService RPCs (tenants, API keys, providers). Min 32 chars.
# Required whenever APP_ENV is not local.
# Generate one: openssl rand -hex 32
ADMIN_API_KEY=
# Seconds a resolved API key is cached in Redis
API_KEY_CACHE_TTL_SECONDS=60
# Calls per tenant per window (all RPCs combined)
THROTTLE_LIMIT=600
THROTTLE_TTL_SECONDS=60

# Optional: create this tenant with this exact API key on startup (local dev)
BOOTSTRAP_TENANT_NAME=Local Dev
BOOTSTRAP_TENANT_SLUG=local
BOOTSTRAP_TENANT_API_KEY=chk_local_dev_key_change_me

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=communication_hub
# true for managed databases that require TLS (RDS, Neon, Supabase, ...)
DB_SSL=false
DB_LOGGING=false
# Connections per process
DB_POOL_SIZE=10

# ---------- Redis (cache, rate limits, BullMQ queues) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
# true for Redis Cluster (e.g. ElastiCache cluster mode)
REDIS_CLUSTER=false
# Namespace for every key; use different values per environment on a shared Redis
REDIS_KEY_PREFIX=chub

# ---------- Queue / workers ----------
# Delivery attempts per notification, exponential backoff base
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=5000
# Sweeper re-enqueues notifications stuck this long (orphans after a crash
# between the DB write and the queue push are delivered within ~3 minutes)
QUEUE_STUCK_AFTER_MINUTES=2
# Per channel: parallel jobs per worker process, and a rate limit shared by
# ALL workers (RATE_MAX jobs per RATE_DURATION_MS) to respect vendor limits.
EMAIL_WORKER_CONCURRENCY=20
EMAIL_RATE_MAX=100
EMAIL_RATE_DURATION_MS=1000
SMS_WORKER_CONCURRENCY=10
SMS_RATE_MAX=100
SMS_RATE_DURATION_MS=1000
PUSH_WORKER_CONCURRENCY=20
PUSH_RATE_MAX=100
PUSH_RATE_DURATION_MS=1000
IN_APP_WORKER_CONCURRENCY=20
IN_APP_RATE_MAX=100
IN_APP_RATE_DURATION_MS=1000
# In-app inbox messages are deleted this many days after delivery
INBOX_RETENTION_DAYS=90

# ---------- Platform default providers ----------
# Used for tenants without their own provider configs for a channel
# (ProviderAdminService). Tenant configs live in the database.

# ---------- Email ----------
# console (log only, not allowed outside APP_ENV=local) | smtp | ses | sendgrid
EMAIL_PROVIDER=console
# "From" when neither the request, a sender rule nor a tenant default sender applies
MAIL_FROM=Communication Hub <no-reply@example.com>
# smtp
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
# (SMTP_PASSWORD is accepted as an alias, like in the backend service)
SMTP_PASS=
# sendgrid
SENDGRID_API_KEY=

# ---------- SMS ----------
# console (log only) | twilio | sns
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender number, or (preferred at scale) a Messaging Service SID
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# sns: optional alphanumeric sender id
SNS_SENDER_ID=

# ---------- Push ----------
# console (log only) | fcm
PUSH_PROVIDER=console
# Firebase service account: raw JSON, base64 JSON or a file path.
# Empty = Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS).
FIREBASE_SERVICE_ACCOUNT=

# ---------- AWS (Secrets Manager / SES / SNS) ----------
AWS_REGION=us-east-1
# Leave empty to use the default credential chain (IAM role / IRSA) - preferred
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------- NestJS Observe (optional) - https://observe.nestjs.com ----------
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
